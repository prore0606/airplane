# ============================================================
# 공공데이터포털 인증키 (data.go.kr 에서 발급)
# 실제 키는 .env.local 에 입력 (절대 커밋 금지)
# ============================================================
VITE_DATA_GO_KR_API_KEY=your_api_key_here

# 인천국제공항공사 - 여객편 운항현황(다국어)
VITE_API_FLIGHT_STATUS=https://apis.data.go.kr/B551177/StatusOfPassengerFlightsOdp

# 인천국제공항공사 - 여객편 주간 운항현황
VITE_API_FLIGHT_WEEKLY=https://apis.data.go.kr/B551177/StatusOfPassengerFlightsDSOdp

# 인천국제공항공사 - 출국장 혼잡도 조회
VITE_API_DEPARTURE_CONGESTION=https://apis.data.go.kr/B551177/statusOfDepartureCongestion

# 인천국제공항공사 - 주차 정보
VITE_API_PARKING_ICN=https://apis.data.go.kr/B551177/StatusOfParking

# 인천국제공항공사 - 셔틀버스 정보
VITE_API_SHUTTLE_BUS=https://apis.data.go.kr/B551177/ShtbusInfo

# 인천국제공항공사 - 항공기 운항현황 상세
VITE_API_FLIGHT_DETAIL=https://apis.data.go.kr/B551177/FlightStatusList

# 한국공항공사 - 전국공항 실시간 주차정보
VITE_API_PARKING_NATIONAL=https://openapi.airport.co.kr/service/rest/AirportParking/airportparkingRT

# ============================================================
# Supabase (추후 연동)
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================
# Firebase FCM (추후 연동)
# ============================================================
VITE_FIREBASE_API_KEY=your_firebase_key_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
